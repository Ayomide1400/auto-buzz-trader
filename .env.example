# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Vercel Cron auth — any random string, must match the value set on Vercel
CRON_SECRET=

# Vercel Edge Config (pause/resume flag) — created via `vercel global-config add`
EDGE_CONFIG=
VERCEL_EDGE_CONFIG_ID=

# Personal Vercel API token (write access), created via `vercel tokens add`
VERCEL_API_TOKEN=
