# Alpaca paper trading (https://app.alpaca.markets/paper/dashboard/overview)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Vercel Cron auth — any random string, must match the value set on Vercel
CRON_SECRET=

# Pause/resume flag and the trade history are stored as JSON files in
# this repo (state/trading-status.json, state/trade-log.json), read and
# written live via the GitHub Contents API.
GITHUB_TOKEN=
GITHUB_REPO=Ayomide1400/auto-buzz-trader

# Optional: push a notification whenever a trade fires. No signup needed —
# pick any topic name, then open https://ntfy.sh/<topic> in a browser or
# the ntfy app to receive it. Leave blank to disable notifications.
NTFY_TOPIC=
